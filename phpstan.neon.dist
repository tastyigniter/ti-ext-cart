includes:
    - ./vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src/
        - config/
        - database/
        - resources/
    ignoreErrors:
        - identifier: trait.unused
        - identifier: larastan.relationExistence
    treatPhpDocTypesAsCertain: false
